+
+    add_button("zoom_out", "缩小", "缩小", [this]() { run_ui_command("zoom_out"); }, false);
+    add_button("zoom_in", "放大", "放大", [this]() { run_ui_command("zoom_in"); }, false);
+    add_button("fit", "适应宽度", "让页面宽度适应窗口",
+               [this]() { run_ui_command("fit_to_page_width"); }, false);
