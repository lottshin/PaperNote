+std::wstring MainWidget::handle_export_highlights() {
+    if (!main_document_view_has_document()) {
+        return L"";
+    }
+
+    Document* document = doc();
+    if (!document) {
+        return L"";
+    }
+
+    struct NoteEntry {
+        int page;
+        bool is_bookmark;
+        QString text;
+        QString note;
+    };
+
+    std::vector<NoteEntry> entries;
+
+    for (const Highlight& highlight : document->get_highlights()) {
+        NoteEntry entry;
+        entry.page = document->get_offset_page_number(highlight.selection_begin.y);
+        entry.is_bookmark = false;
+        entry.text = QString::fromStdWString(highlight.description).trimmed();
+        entry.note = QString::fromStdWString(highlight.text_annot).trimmed();
+        entries.push_back(entry);
+    }
+
+    for (const BookMark& bookmark : document->get_bookmarks()) {
+        NoteEntry entry;
+        entry.page = document->get_offset_page_number(bookmark.y_offset_);
+        entry.is_bookmark = true;
+        entry.text = QString::fromStdWString(bookmark.description).trimmed();
+        entries.push_back(entry);
+    }
+
+    if (entries.empty()) {
+        set_status_message(L"当前文档没有高亮或书签，无需导出");
+        return L"";
+    }
+
+    std::stable_sort(entries.begin(), entries.end(), [](const NoteEntry& lhs, const NoteEntry& rhs) {
+        if (lhs.page != rhs.page) {
+            return lhs.page < rhs.page;
+        }
+        return lhs.is_bookmark && !rhs.is_bookmark;
+    });
+
+    QFileInfo document_info(QString::fromStdWString(document->get_path()));
+    QString export_path = document_info.dir().filePath(document_info.completeBaseName() + ".notes.md");
+
+    int highlight_count = 0;
+    for (const NoteEntry& entry : entries) {
+        if (!entry.is_bookmark) {
+            highlight_count++;
+        }
+    }
+
+    QString markdown;
+    markdown += QString("# %1 · 阅读笔记\n\n").arg(document_info.completeBaseName());
+    markdown += QString("> 导出自 PaperNote（Sioyek 二次开发版） · %1\n\n")
+                    .arg(QDateTime::currentDateTime().toString("yyyy-MM-dd HH:mm"));
+    markdown += QString("高亮 %1 条 · 书签 %2 条\n\n")
+                    .arg(highlight_count)
+                    .arg(entries.size() - highlight_count);
+
+    int current_page = -1;
+    for (const NoteEntry& entry : entries) {
+        if (entry.page != current_page) {
+            markdown += QString("## 第 %1 页\n\n").arg(entry.page + 1);
+            current_page = entry.page;
+        }
+
+        if (entry.is_bookmark) {
+            markdown += QString("- **书签**：%1\n\n").arg(entry.text);
+        }
+        else {
+            QString quoted = entry.text;
+            quoted.replace("\n", "\n> ");
+            markdown += QString("> %1\n\n").arg(quoted);
+
+            if (!entry.note.isEmpty()) {
+                markdown += QString("**批注**：%1\n\n").arg(entry.note);
+            }
+        }
+    }
+
+    QFile export_file(export_path);
+    if (!export_file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        set_status_message(QString("导出失败：无法写入 %1").arg(export_path).toStdWString());
+        return L"";
+    }
+
+    export_file.write(markdown.toUtf8());
+    export_file.close();
+
+    set_status_message(QString("已导出 %1 条标注到 %2")
+                        .arg(entries.size())
+                        .arg(export_path)
+                        .toStdWString());
+
+    // Make the result actionable for mouse-first users. The env var keeps
+    // scripted/CLI usage non-blocking.
+    if (qEnvironmentVariableIsEmpty("PAPERNOTE_NO_UI")) {
+        QMessageBox message_box(this);
+        message_box.setWindowTitle("导出完成");
+        message_box.setText(QString("已导出 %1 条标注到：\n%2").arg(entries.size()).arg(export_path));
+
+        QPushButton* open_file_button = message_box.addButton("打开笔记", QMessageBox::AcceptRole);
+        QPushButton* open_folder_button = message_box.addButton("打开所在文件夹", QMessageBox::ActionRole);
+        message_box.addButton("关闭", QMessageBox::RejectRole);
+        message_box.exec();
+
+        if (message_box.clickedButton() == open_file_button) {
+            QDesktopServices::openUrl(QUrl::fromLocalFile(export_path));
+        }
+        else if (message_box.clickedButton() == open_folder_button) {
+            QDesktopServices::openUrl(QUrl::fromLocalFile(document_info.dir().absolutePath()));
+        }
     }
+
+    return export_path.toStdWString();
 }
 
+void MainWidget::show_home_dialog(bool auto_show) {
+    std::vector<std::pair<std::wstring, std::wstring>> recent_books;
+    if (db_manager) {
+        db_manager->select_opened_books_path_and_doc_names(recent_books);
+    }
+
+    struct RecentEntry {
+        QString path;
+        QString title;
+    };
+
+    std::vector<RecentEntry> entries;
+    for (const auto& [hash_w, name_w] : recent_books) {
+        // opened_books stores the document checksum, not the filesystem path.
+        std::vector<std::wstring> paths;
+        if (db_manager) {
+            db_manager->get_path_from_hash(utf8_encode(hash_w), paths);
+        }
+        if (paths.empty()) {
+            continue;
+        }
+
+        QString path = QString::fromStdWString(paths.back());
+        if (!QFileInfo::exists(path)) {
+            continue;
+        }
+
+        QString name = QString::fromStdWString(name_w).trimmed();
+        if (name.isEmpty()) {
+            name = QFileInfo(path).fileName();
+        }
+
+        if (name.size() > 42) {
+            name = name.left(42) + QString::fromUtf8("…");
+        }
+        entries.push_back({path, name});
+        if (entries.size() >= 12) {
+            break;
+        }
+    }
+
+    // Auto-show only makes sense once the user actually has something to resume.
+    if (auto_show && entries.empty()) {
+        return;
+    }
+
+    QDialog dialog(this);
+    dialog.setWindowTitle("PaperNote");
+    dialog.setMinimumSize(640, 480);
+
+    QVBoxLayout* layout = new QVBoxLayout(&dialog);
+    layout->setContentsMargins(24, 22, 24, 20);
+    layout->setSpacing(10);
+
+    QLabel* title = new QLabel("PaperNote", &dialog);
+    title->setStyleSheet("font-size: 28px; font-weight: 600; color: #ffffff;");
+    QLabel* subtitle = new QLabel("继续阅读最近的文档，或打开新的 PDF", &dialog);
+    subtitle->setStyleSheet("color: #a9a6ba; font-size: 13px;");
+    layout->addWidget(title);
+    layout->addSpacing(4);
+    layout->addWidget(subtitle);
+    layout->addSpacing(8);
+
+    QListWidget* list = new QListWidget(&dialog);
+    list->setWordWrap(false);
+    list->setTextElideMode(Qt::ElideRight);
+    list->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    list->setUniformItemSizes(true);
+    for (const RecentEntry& entry : entries) {
+        QListWidgetItem* item = new QListWidgetItem(entry.title, list);
+        item->setIcon(papernote::icon("page", papernote::kTextMuted, 36));
+        item->setData(Qt::UserRole, entry.path);
+        item->setToolTip(entry.path);
+        item->setSizeHint(QSize(0, 44));
+    }
+    if (entries.empty()) {
+        QListWidgetItem* item = new QListWidgetItem("还没有最近打开的文档，点击下方「打开 PDF…」开始", list);
+        item->setFlags(Qt::NoItemFlags);
+    }
+    if (list->count() > 0) {
+        list->setCurrentRow(0);
+    }
+    layout->addWidget(list, 1);
+
+    QHBoxLayout* buttons = new QHBoxLayout();
+    QPushButton* open_button = new QPushButton("打开 PDF…", &dialog);
+    open_button->setProperty("primary", true);
+    QPushButton* help_button = new QPushButton("快速上手", &dialog);
+    help_button->setProperty("ghost", true);
+    QPushButton* close_button = new QPushButton("关闭", &dialog);
+    close_button->setProperty("ghost", true);
+    buttons->addWidget(open_button);
+    buttons->addStretch();
+    buttons->addWidget(help_button);
+    buttons->addWidget(close_button);
+    layout->addLayout(buttons);
+
+    QString chosen_path;
+    QObject::connect(open_button, &QPushButton::clicked, &dialog, [&]() { dialog.done(2); });
+    QObject::connect(help_button, &QPushButton::clicked, &dialog, [&]() { dialog.done(3); });
+    QObject::connect(close_button, &QPushButton::clicked, &dialog, [&]() { dialog.done(0); });
+    QObject::connect(list, &QListWidget::itemActivated, &dialog, [&](QListWidgetItem* item) {
+        chosen_path = item->data(Qt::UserRole).toString();
+        dialog.done(1);
+    });
+
+    int result = dialog.exec();
+
+    if (result == 1 && !chosen_path.isEmpty()) {
+        push_state();
+        open_document(chosen_path.toStdWString());
+    }
+    else if (result == 1 || result == 2) {
+        run_ui_command("open_document");
+    }
+    else if (result == 3) {
+        show_quickstart_dialog();
+    }
+}
+
+void MainWidget::show_quickstart_dialog() {
+    QMessageBox message_box(this);
+    message_box.setWindowTitle("PaperNote 快速上手");
+    message_box.setTextFormat(Qt::RichText);
+    message_box.setText(papernote_quickstart_html());
+
+    QPushButton* open_document_button = nullptr;
+    if (!main_document_view_has_document()) {
+        open_document_button = message_box.addButton("打开 PDF", QMessageBox::AcceptRole);
+        open_document_button->setProperty("primary", true);
+    }
+    message_box.addButton("知道了", QMessageBox::RejectRole);
+    message_box.exec();
+
+    if (open_document_button && message_box.clickedButton() == open_document_button) {
+        run_ui_command("open_document");
+    }
+}
