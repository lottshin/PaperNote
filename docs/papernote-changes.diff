+std::wstring MainWidget::handle_export_highlights() {
+    if (!main_document_view_has_document()) {
+        return L"";
+    }
+
+    Document* document = doc();
+    if (!document) {
+        return L"";
+    }
+
+    struct NoteEntry {
+        int page;
+        bool is_bookmark;
+        QString text;
+        QString note;
+    };
+
+    std::vector<NoteEntry> entries;
+
+    for (const Highlight& highlight : document->get_highlights()) {
+        NoteEntry entry;
+        entry.page = document->get_offset_page_number(highlight.selection_begin.y);
+        entry.is_bookmark = false;
+        entry.text = QString::fromStdWString(highlight.description).trimmed();
+        entry.note = QString::fromStdWString(highlight.text_annot).trimmed();
+        entries.push_back(entry);
+    }
+
+    for (const BookMark& bookmark : document->get_bookmarks()) {
+        NoteEntry entry;
+        entry.page = document->get_offset_page_number(bookmark.y_offset_);
+        entry.is_bookmark = true;
+        entry.text = QString::fromStdWString(bookmark.description).trimmed();
+        entries.push_back(entry);
+    }
+
+    if (entries.empty()) {
+        set_status_message(L"当前文档没有高亮或书签，无需导出");
+        return L"";
+    }
+
+    std::stable_sort(entries.begin(), entries.end(), [](const NoteEntry& lhs, const NoteEntry& rhs) {
+        if (lhs.page != rhs.page) {
+            return lhs.page < rhs.page;
+        }
+        return lhs.is_bookmark && !rhs.is_bookmark;
+    });
+
+    QFileInfo document_info(QString::fromStdWString(document->get_path()));
+    QString export_path = document_info.dir().filePath(document_info.completeBaseName() + ".notes.md");
+
+    int highlight_count = 0;
+    for (const NoteEntry& entry : entries) {
+        if (!entry.is_bookmark) {
+            highlight_count++;
+        }
+    }
+
+    QString markdown;
+    markdown += QString("# %1 · 阅读笔记\n\n").arg(document_info.completeBaseName());
+    markdown += QString("> 导出自 PaperNote（Sioyek 二次开发版） · %1\n\n")
+                    .arg(QDateTime::currentDateTime().toString("yyyy-MM-dd HH:mm"));
+    markdown += QString("高亮 %1 条 · 书签 %2 条\n\n")
+                    .arg(highlight_count)
+                    .arg(entries.size() - highlight_count);
+
+    int current_page = -1;
+    for (const NoteEntry& entry : entries) {
+        if (entry.page != current_page) {
+            markdown += QString("## 第 %1 页\n\n").arg(entry.page + 1);
+            current_page = entry.page;
+        }
+
+        if (entry.is_bookmark) {
+            markdown += QString("- **书签**：%1\n\n").arg(entry.text);
+        }
+        else {
+            QString quoted = entry.text;
+            quoted.replace("\n", "\n> ");
+            markdown += QString("> %1\n\n").arg(quoted);
+
+            if (!entry.note.isEmpty()) {
+                markdown += QString("**批注**：%1\n\n").arg(entry.note);
+            }
+        }
+    }
+
+    QFile export_file(export_path);
+    if (!export_file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        set_status_message(QString("导出失败：无法写入 %1").arg(export_path).toStdWString());
+        return L"";
+    }
+
+    export_file.write(markdown.toUtf8());
+    export_file.close();
+
+    set_status_message(QString("已导出 %1 条标注到 %2")
+                        .arg(entries.size())
+                        .arg(export_path)
+                        .toStdWString());
+
+    // Make the result actionable for mouse-first users. The env var keeps
+    // scripted/CLI usage non-blocking.
+    if (qEnvironmentVariableIsEmpty("PAPERNOTE_NO_UI")) {
+        QMessageBox message_box(this);
+        message_box.setWindowTitle("导出完成");
+        message_box.setText(QString("已导出 %1 条标注到：\n%2").arg(entries.size()).arg(export_path));
+
+        QPushButton* open_file_button = message_box.addButton("打开笔记", QMessageBox::AcceptRole);
+        QPushButton* open_folder_button = message_box.addButton("打开所在文件夹", QMessageBox::ActionRole);
+        message_box.addButton("关闭", QMessageBox::RejectRole);
+        message_box.exec();
+
+        if (message_box.clickedButton() == open_file_button) {
+            QDesktopServices::openUrl(QUrl::fromLocalFile(export_path));
+        }
+        else if (message_box.clickedButton() == open_folder_button) {
+            QDesktopServices::openUrl(QUrl::fromLocalFile(document_info.dir().absolutePath()));
+        }
+    }
+
+    return export_path.toStdWString();
+}
