+inline QString papernote_tr_menu(const QString& english) {
+    static const std::unordered_map<QString, QString> map = {
+        {"File", "文件"},
+        {"Window", "窗口"},
+        {"View", "视图"},
+        {"Navigate", "导航"},
+        {"Annotations", "注释"},
+        {"Highlights", "高亮"},
+        {"Bookmarks", "书签"},
+        {"Marks", "标记"},
+        {"Portals", "门户"},
+        {"Overview", "预览"},
+        {"Drawings", "手绘"},
+        {"Tools", "工具"},
+        {"Preferences", "偏好设置"},
+        {"Help", "帮助"},
+        {"Scratchpad", "草稿板"},
+        {"Ruler", "标尺"},
+    };
+
+    auto it = map.find(english);
+    return it == map.end() ? english : it->second;
+}
